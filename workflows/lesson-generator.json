      ],
      "id": "5fc385f9-d631-408c-8521-71a22334a0e6",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "xYGyoa2w5r49GhhP",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $('Limit').all();\n\nreturn $input.all().map((item, i) => {\n  let t = (item.json.text || '').trim();\n\n  // 1. escape everything\n  t = t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\n  // 2. restore the tags Telegram supports\n  t = t.replace(/&lt;(\\/?)(b|i|code|pre)&gt;/gi, '<$1$2>');\n\n  // 3. convert Markdown the AI may still use\n  t = t.replace(/```[a-z]*\\n?([\\s\\S]*?)```/g, '<pre>$1</pre>')\n       .replace(/\\*\\*(.+?)\\*\\*/g, '<b>$1</b>');\n\n  // 4. stay under Telegram's 4096 character limit\n  t = t.slice(0, 3900);\n\n  return { json: { id: rows[i].json.id, content: t } };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
