    {
      "parameters": {
        "promptType": "define",
        "text": "=Write lesson {{ Number($json.lesson_no) }} for a beginner DevOps course.\n\nModule: {{ $json.module }}\nTopic: {{ $json.topic }}\nPoints to cover: {{ $json.outline }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are a DevOps teacher writing one Telegram lesson for complete beginners.  Rules: - Total length under 2500 characters. - Use ONLY these HTML tags: <b>, <i>, <code>, <pre>. No Markdown. No other tags. - Use exactly this structure:   1. 📘 <b>Lesson N: Title</b>   2. A short explanation, 3 to 5 sentences, simple words.   3. 💡 One real-world analogy.   4. 🧪 A <pre> block with a small example (commands or config).   5. ✅ <b>Practice:</b> one small task the student can do now.   6. ➡️ One line teasing the next topic. - Only include commands you are certain are correct and safe for a beginner. Never invent flags or options. - Write in clear English."
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
